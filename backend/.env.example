# GrowMint Secure Banking Backend Environment Variables
PORT=4000
NODE_ENV=development

# 32-byte hex key for AES-256-GCM token encryption at rest
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session Secret for HttpOnly cookie authentication
SESSION_SECRET=growmint-super-secure-session-key-must-be-long-and-random-321

# Plaid API credentials (Sandbox by default)
# Get your keys at https://dashboard.plaid.com
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
PLAID_WEBHOOK_SECRET=your_plaid_webhook_verification_key

# Allowed client origin for CORS
CLIENT_ORIGIN=https://ais-dev-wt4cpwje43gerrmnerzzuo-428422984777.asia-northeast1.run.app
