# GrowMint Environment Variables (Placeholder Values Only)
# Copy this file to .env and fill in your own values. Never commit .env to Git.

# --- Gemini / AI ---
# Required if you configure direct Gemini API access or extend the project to use GEMINI_API_KEY.
# Note: The current Android client calls Gemini via Firebase AI Logic (configured by app/google-services.json and App Check).
GEMINI_API_KEY=your_gemini_api_key_here

# Debug-only Firebase App Check token (passed via Intent extra during local debug testing; ignored in release BuildsConfig)
FIREBASE_APPCHECK_DEBUG_TOKEN=your_firebase_appcheck_debug_token_here

# --- Android Release Signing (used by app/build.gradle.kts) ---
KEYSTORE_PATH=/path/to/your-upload-key.jks
STORE_PASSWORD=your_keystore_store_password_here
KEY_PASSWORD=your_keystore_key_password_here

# --- Optional Banking Backend Prototype (/backend) ---
# Only needed if running the standalone Node/Express backend prototype in /backend.
PORT=4000
NODE_ENV=development
TOKEN_ENCRYPTION_KEY=replace_with_64_char_hex_32_byte_encryption_key
SESSION_SECRET=replace_with_long_random_session_secret
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
PLAID_WEBHOOK_SECRET=your_plaid_webhook_secret_here
CLIENT_ORIGIN=http://localhost:8080
